<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Verifable" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_light</item>
        
        <!-- Custom attributes -->
        <item name="splashBackgroundColor">@color/background_light</item>
        <item name="splashIconBackground">@color/primary_light</item>
        <item name="brandingImageColor">@color/branding_light</item>
        
        <!-- System bars -->
        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Verifable.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">?attr/splashBackgroundColor</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ap_splash_screen</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/branding_image_layer_list</item>
        <item name="postSplashScreenTheme">@style/Theme.Verifable</item>
    </style>
</resources>