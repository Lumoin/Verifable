<?xml version="1.0" encoding="utf-8" ?>
<resources
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Maui.SplashTheme is based on
    https://github.com/dotnet/maui/blob/main/src/Core/src/Platform/Android/Resources/values/styles.xml    
  -->
  <style name="VerifableTheme" parent="@style/Maui.SplashTheme">
    <item name="android:windowSplashScreenBackground">@color/colorPrimary</item>
    <item name="android:windowLightStatusBar">true</item>   
  </style>

  
  <!-- Add this theme: -->
  <!-- Splash Screen Theme (API >= 31) -->
  <style name="SplashTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
