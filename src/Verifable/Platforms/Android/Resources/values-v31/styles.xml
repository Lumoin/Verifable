    <!-- <item name="windowSplashScreenAnimatedIcon">@mipmap/appicon</item> -->
    <!-- <item name="windowSplashScreenAnimationDuration">300</item> -->
    
    <!-- Status bar and Nav bar configs -->
    <!--
    <item name="android:statusBarColor" tools:targetApi="l">@color/colorPrimaryDark</item>
    <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    -->
    <item name="android:windowLightStatusBar">false</item>

    <item name="android:windowSplashScreenAnimatedIcon">@drawable/ap_splash_screen</item>
    <item name="android:windowSplashScreenAnimationDuration">1000</item>
    <item name="postSplashScreenTheme">@style/VerifableTheme</item>
    


