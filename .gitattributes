# Auto detect text files.
* text=auto

# If repository files are accessed in Windows via a file share from Linux,
# the scripts are more likely to work with this setting.
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf

# Bash scripts are most likely used in Linux and so likelies to work with LF endings.
*.sh text eol=lf

